<Window x:Class="CodexEnhance.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Codex 状态浮窗" Width="354" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="False" FontFamily="Segoe UI, Microsoft YaHei UI" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
 <Border x:Name="Card" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="14" ClipToBounds="True">
  <Grid>
   <Grid x:Name="Pill" Margin="14,12" Background="Transparent" Visibility="Collapsed" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag" Cursor="Hand" ToolTip="点击展开，拖动调整位置" AutomationProperties.Name="展开状态浮窗">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Ellipse x:Name="PillDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,10,0"/>
    <TextBlock x:Name="PillPhase" Grid.Column="1" Text="正在连接" TextTrimming="CharacterEllipsis" FontSize="13"/>
    <TextBlock x:Name="PillMetric" Grid.Column="2" Margin="12,0" FontSize="13" Foreground="{DynamicResource Muted}"/>
    <ContentControl x:Name="PillChevron" Grid.Column="3"/>
   </Grid>
   <StackPanel x:Name="ExpandedContent">
    <Grid x:Name="Header" Margin="19,17,14,0" Background="Transparent" MouseLeftButtonDown="BeginDrag" MouseMove="DragMove" MouseLeftButtonUp="EndDrag">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="当前任务" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="FreshnessText" Text="连接中" FontSize="10" Foreground="{DynamicResource Faint}" Margin="10,4,0,0"/></StackPanel><Button x:Name="TaskPicker" Padding="0,5,0,0" HorizontalAlignment="Left" Click="OpenTaskPicker" ToolTip="选择要监视的任务" AutomationProperties.Name="选择监视任务"><TextBlock x:Name="TaskTitle" Text="等待 Codex" MaxWidth="238" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}" FontSize="12"/></Button></StackPanel>
     <Button x:Name="MenuButton" Grid.Column="1" Width="28" Height="28" Margin="0,0,3,0" VerticalAlignment="Top" Click="ShowMenu" ToolTip="更多选项" AutomationProperties.Name="更多选项"/>
     <Button x:Name="CollapseButton" Grid.Column="2" Width="28" Height="28" VerticalAlignment="Top" Click="Collapse" ToolTip="收起浮窗" AutomationProperties.Name="收起浮窗"/>
    </Grid>
    <Grid Margin="19,20,19,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Ellipse x:Name="PhaseDot" Width="8" Height="8" Fill="{DynamicResource Accent}" Margin="0,0,9,0"/>
     <TextBlock x:Name="PhaseText" Grid.Column="1" Text="正在连接" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock x:Name="ElapsedText" Grid.Column="2" Text="—" FontSize="18" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
    </Grid>
    <TextBlock x:Name="ProgressText" Margin="36,5,19,0" Text="等待状态记录" Foreground="{DynamicResource Faint}" FontSize="11"/>
    <Button x:Name="MetricsButton" Margin="16,15,16,15" Padding="3" HorizontalContentAlignment="Stretch" Click="OpenMetrics" ToolTip="查看用量、首 token 与压缩记录" AutomationProperties.Name="查看性能详情">
     <Grid Width="312"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,15,0"><TextBlock Text="上下文" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="ContextText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/>
       <Grid Margin="0,9,0,3" Height="3" Width="85" HorizontalAlignment="Left"><Border Background="{DynamicResource Track}" CornerRadius="1.5"/><Border x:Name="ContextFill" Width="0" HorizontalAlignment="Left" Background="{DynamicResource Accent}" CornerRadius="1.5"/></Grid>
      </StackPanel>
      <Border Grid.Column="1" Background="{DynamicResource Line}" Margin="0,2"/>
      <StackPanel Grid.Column="2" Margin="17,0,0,0"><TextBlock Text="缓存命中" FontSize="12" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="CacheText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock Text="最近请求" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel>
      <Border Grid.Column="3" Background="{DynamicResource Line}" Margin="0,2"/>
      <StackPanel Grid.Column="4" Margin="17,0,0,0"><TextBlock Text="首字（日志）" FontSize="11" Foreground="{DynamicResource Muted}"/><TextBlock x:Name="FirstTokenText" Text="—" FontSize="20" FontWeight="SemiBold" Margin="0,5,0,0" Typography.NumeralAlignment="Tabular"/><TextBlock x:Name="FirstTokenSource" Text="暂无记录" FontSize="10" Foreground="{DynamicResource Faint}" Margin="0,5,0,0"/></StackPanel>
     </Grid>
    </Button>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <Button x:Name="ToolsButton" Padding="19,14" Click="ToggleTools" HorizontalContentAlignment="Stretch" AutomationProperties.Name="展开工具调用">
     <Grid Width="314"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <ContentControl x:Name="ToolsIcon" Margin="0,0,10,0"/><TextBlock Grid.Column="1" Text="工具调用" FontSize="14" FontWeight="Medium"/>
      <TextBlock x:Name="ToolsSummary" Grid.Column="2" Text="等待记录" HorizontalAlignment="Right" FontSize="13" Margin="10,0,10,0" TextTrimming="CharacterEllipsis"/><ContentControl x:Name="ToolsChevron" Grid.Column="3"/>
     </Grid>
    </Button>
    <StackPanel x:Name="ToolsDetails" Visibility="Collapsed" Margin="19,0,19,16">
     <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="IssueList"/></ScrollViewer>
     <Border Height="1" Background="{DynamicResource Line}" Margin="0,12,0,9"/>
     <Button Padding="0,3" HorizontalAlignment="Left" Click="OpenHistory" AutomationProperties.Name="查看全部调用"><StackPanel Orientation="Horizontal"><TextBlock Text="查看全部调用" Foreground="{DynamicResource Accent}" FontSize="13"/><ContentControl x:Name="HistoryArrow" Margin="7,2,0,0"/></StackPanel></Button>
    </StackPanel>
    <Border Height="1" Background="{DynamicResource Line}"/>
    <Grid Margin="19,12,16,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <ContentControl x:Name="ModelIcon" Margin="0,0,8,0"/><TextBlock x:Name="ModelText" Grid.Column="1" Text="尚无记录" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"/>
     <Button x:Name="FollowButton" Grid.Column="2" Padding="4,2" Click="Follow" AutomationProperties.Name="跟随对话"><StackPanel Orientation="Horizontal"><ContentControl x:Name="FollowIcon" Margin="0,0,6,0"/><TextBlock x:Name="FollowText" Text="跟随对话" Foreground="{DynamicResource Muted}" FontSize="12"/></StackPanel></Button>
    </Grid>
    <Border x:Name="ConnectionNotice" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Padding="19,9"><TextBlock x:Name="ConnectionText" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/></Border>
   </StackPanel>
  </Grid>
 </Border>
</Window>
